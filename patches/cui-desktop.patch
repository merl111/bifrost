diff --git a/tests/winui_memory.c b/tests/winui_memory.c
new file mode 100644
index 0000000..9743d8b
--- /dev/null
+++ b/tests/winui_memory.c
@@ -0,0 +1,73 @@
+/* Native Windows repaint workload; samples are diagnostics, not a leak verdict. */
+#include "cui.h"
+#include "cui_draw.h"
+#include <assert.h>
+#include <stdio.h>
+#include <windows.h>
+#include <psapi.h>
+#include "windows_diagnostics.h"
+
+static cui_app *app;
+static cui_widget *canvas;
+static cui_surface *surface;
+static unsigned step;
+
+static void sample(void) {
+    PROCESS_MEMORY_COUNTERS_EX counters = {0};
+    DWORD handles = 0;
+    counters.cb = sizeof(counters);
+    assert(GetProcessMemoryInfo(GetCurrentProcess(),
+                               (PROCESS_MEMORY_COUNTERS *)&counters, sizeof(counters)));
+    assert(GetProcessHandleCount(GetCurrentProcess(), &handles));
+    printf("step=%u working_set_kib=%zu private_commit_kib=%zu handles=%lu gdi=%lu user=%lu\n",
+           step, counters.WorkingSetSize / 1024, counters.PrivateUsage / 1024, handles,
+           GetGuiResources(GetCurrentProcess(), GR_GDIOBJECTS),
+           GetGuiResources(GetCurrentProcess(), GR_USEROBJECTS));
+    fflush(stdout);
+}
+
+static void tick(void *data) {
+    cui_window *window = data;
+    ++step;
+    if (step <= 1000) {
+        /* Exercise same-size updates, a larger backing buffer, then shrink it. */
+        if (step == 500 || step == 750) {
+            cui_surface_release(surface);
+            surface = cui_surface_create(960, 540, step == 500 ? 2 : 1);
+            assert(surface);
+        }
+        cui_draw_command draw = {0};
+        draw.op = CUI_DRAW_CLEAR;
+        draw.color = (step & 1) ? 0x123456ff : 0xabcdef80;
+        assert(cui_surface_render(surface, &draw, 1));
+        assert(cui_canvas_set_surface(canvas, surface));
+        assert(cui_set_opacity(canvas, step % 10 ? 1 : .5));
+    }
+    assert(!*cui_app_error(app));
+    if (step % 100 == 0)
+        sample();
+    /* Let queued presentation work settle for another second. */
+    if (step == 1100)
+        cui_window_close(window);
+}
+
+int main(void) {
+    cui_test_windows_diagnostics();
+    app = cui_app_create();
+    assert(app);
+    cui_window *window = cui_window_create(app, "CUI Windows repaint memory", 960, 540);
+    assert(window);
+    canvas = cui_canvas(cui_window_root(window));
+    surface = cui_surface_create(960, 540, 1);
+    assert(canvas && surface);
+    cui_expand(canvas, 1);
+    assert(cui_every(app, 10, tick, window));
+    cui_window_show(window);
+    sample();
+    cui_app_run(app);
+    assert(step == 1100);
+    cui_surface_release(surface);
+    cui_app_destroy(app);
+    puts("Windows repeated canvas updates, resize, opacity and teardown completed");
+    return 0;
+}
