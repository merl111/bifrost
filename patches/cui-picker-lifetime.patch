+static void accept_selected(void *data)
+{
+    picker_state *s=data;cui_item_id id=s->pending;s->pending=0;
+    cui_timer_stop(s->accept_timer);
+    if(!id||!s->open)return;
+    for(cui_widget *p=s->root;p;p=p->parent)if(p->hidden||!p->enabled)return;
+    if(cui_picker_select(s->root,id))emit(s,CUI_PICKER_SELECT);
+}
 static void result_selected(cui_widget *sender,void *data)
 {
     picker_state *s=data;int row,column;
     if(cui_table_last_event(sender,&row,&column)!=CUI_TABLE_SELECTION)return;
     cui_choice_entry *item=at_row(s,cui_get_selected(sender));
     if(!item||item->disabled){cui_set_selected(sender,-1);return;}
-    cui_picker_accept(s->root);
+    /* Native selection signals are emitted while GTK still uses the selection
+     * model. Accepting synchronously replaces that model in refresh(), freeing
+     * it before gtk_single_selection_set_selected() finishes its notifications.
+     * Copy the stable ID and accept after the native event has unwound. */
+    s->pending=item->id;
+    if(!s->accept_timer)s->accept_timer=cui_every(s->root->window->app,10,accept_selected,s);
+    else cui_timer_start(s->accept_timer);
 }
